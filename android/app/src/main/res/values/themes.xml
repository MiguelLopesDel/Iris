<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the Compose surface from process start, avoiding a white flash. -->
    <style name="Theme.Iris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/iris_startup_background</item>
        <item name="android:colorAccent">#B8FF5A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/iris_startup_background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
