# Copy to .env on the server. Never commit .env or data/.
# Match these IDs to the Linux user that owns this repository and its data/ folder.
IRIS_UID=1000
IRIS_GID=1000

# Docker exposes Iris only on this host-local port. Reaching it from another
# device is up to the private layer you put in front of it — a mesh VPN, a
# tunnel, or a reverse proxy with TLS. Iris does not depend on any of them.
IRIS_PORT=8501

# "auto" enables accounts after scripts/bootstrap_admin.py creates the first one.
IRIS_MULTIUSER=auto
IRIS_SERVER_MODE=private
IRIS_SESSION_HTTPS_ONLY=true

# Conservative defaults for low-power servers.
IRIS_ENGINE_CACHE_SIZE=1
IRIS_SEARCH_WORKERS=2
IRIS_LOAD_MODEL=1
IRIS_MODEL=sentence-transformers/clip-ViT-L-14

# Optional. Leave blank to generate data/secret_key once; back it up with data/.
IRIS_SECRET_KEY=

# Logs: Docker already collects stdout. Use json for a log collector, or text for
# interactive reading. Set IRIS_LOG_FILE only for a host-managed rotating file.
IRIS_LOG_LEVEL=INFO
IRIS_LOG_FORMAT=json
IRIS_LOG_ACCESS=1
IRIS_LOG_FILE=

# Generous storage protections. Values are bytes; 10995116277760 = 10 TiB.
IRIS_MAX_UPLOAD_BYTES=34359738368
IRIS_MAX_UPLOAD_FILES=10000
IRIS_ACCOUNT_QUOTA_BYTES=10995116277760
IRIS_MAX_IMAGE_PIXELS=500000000
IRIS_MAX_REQUEST_BYTES=68719476736
IRIS_MAX_SEARCH_TOP_K=1000
IRIS_MAX_SEARCH_CANDIDATES=20000

# Shared spaces keep their own copy of each item, so deleting a private photo
# never breaks a shared one. How that copy is made:
#   auto     - reflink where the filesystem supports it (btrfs, XFS with
#              reflink=1, bcachefs, ZFS 2.2+ block cloning): an independent
#              copy that costs no extra disk. Otherwise a normal copy. Default.
#   reflink  - require reflinks; the server refuses to start without them.
#   hardlink - no extra disk on any filesystem, but both names are the same
#              file: editing one in place changes the other. Opt-in only.
#   copy     - always a full byte copy.
# See what your data/ folder supports: ./scripts/server.sh storage
IRIS_SPACE_STORAGE=auto
# Per-space limit in bytes (counts each distinct file once, trash included).
IRIS_SPACE_QUOTA_BYTES=10995116277760
# Days a removed item stays restorable before its bytes are freed.
IRIS_SPACE_TRASH_DAYS=30

# Semantic search translates your query to English before encoding it, because
# the embedding model is English-trained. That call goes to an external
# service: your media never leaves the machine, but the words you type do.
# Set to 0 to keep everything local, at the cost of weaker non-English search.
IRIS_TRANSLATE_QUERIES=1
