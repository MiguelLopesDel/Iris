#!/usr/bin/env bash
# One command for the whole cycle, run from your own machine:
#
#   ./iris dev [args]            local sandbox with hot reload (scripts/dev.py)
#   ./iris check                 lint and the standard test suite
#
#   Work locally, test on the phone, open PRs later:
#   ./iris try                   put THIS working copy (committed or not, any branch)
#                                on staging over ssh; GitHub is not involved
#   ./iris save "type(scope): summary" [--body TEXT]
#                                commit the current changes as one logical change on a
#                                local branch (made from the message when on main)
#   ./iris ship                  later: push that branch and open its PR
#
#   ./iris ship "type(scope): summary" [--body TEXT] [--no-check]
#                                commit everything, push a branch, open a PR that
#                                merges itself once CI is green; back on main
#   ./iris sync                  update main and delete branches already merged
#   ./iris staging [--pr N]...   put main (plus open PRs) on the staging server
#   ./iris release X.Y.Z         1st run: PR that bumps the version and adds notes;
#                                2nd run, after it merged: tag vX.Y.Z (publishes the image)
#   ./iris deploy                move production to the newest release (backs up first)
#   ./iris status                health of production and staging
#   ./iris logs [prod|staging]   follow the server logs
#   ./iris doctor [prod|staging] who else on the server can read the library
#   ./iris shell [prod|staging]  a shell inside that installation's folder
#
# Server commands read .iris.local (git-ignored), for example:
#   IRIS_SERVER=myserver               # an ssh host from ~/.ssh/config
#   IRIS_PROD_DIR=/srv/iris/prod
#   IRIS_STAGING_DIR=/srv/iris/staging
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$root"
[ -f .iris.local ] && . ./.iris.local

die() { echo "iris: $*" >&2; exit 1; }
say() { echo "iris: $*"; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed -n 's/^# \{0,1\}//p' | sed '/^set -euo/d'; }

python_bin() {
    for candidate in "${VIRTUAL_ENV:-}/bin/python" venv/bin/python .venv/bin/python; do
        [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return; }
    done
    command -v python3
}

need_gh() { command -v gh >/dev/null 2>&1 || die "install the GitHub CLI (gh) and run: gh auth login"; }

clean_tree() { [ -z "$(git status --porcelain)" ]; }

# --- server -----------------------------------------------------------------

install_dir() {
    case "${1:-prod}" in
        prod) printf '%s\n' "${IRIS_PROD_DIR:?set IRIS_PROD_DIR in .iris.local}" ;;
        staging) printf '%s\n' "${IRIS_STAGING_DIR:?set IRIS_STAGING_DIR in .iris.local}" ;;
        *) die "which installation? prod or staging (got: $1)" ;;
    esac
}

remote() {
    # remote <prod|staging> <command...>: run inside that installation's folder.
    local dir="$1"; shift
    [ -n "${IRIS_SERVER:-}" ] || die "set IRIS_SERVER (an ssh host) in .iris.local"
    ssh -t "$IRIS_SERVER" "cd $(printf '%q' "$(install_dir "$dir")") && $*"
}

quote_args() { local arg out=""; for arg in "$@"; do out+=" $(printf '%q' "$arg")"; done; printf '%s' "$out"; }

# --- git --------------------------------------------------------------------

branch_for() {
    # "fix(ui): keep the menu open" -> fix/keep-the-menu-open
    local message="$1" type rest
    type="$(printf '%s' "$message" | sed -n 's/^\([a-z]*\)[(!:].*/\1/p')"
    case "$type" in
        feat|fix|docs|chore|build|ci|refactor|test|perf) ;;
        *) die "start the message with a Conventional Commit type: feat, fix, docs, chore, build, ci, refactor, test or perf" ;;
    esac
    rest="$(printf '%s' "${message#*: }" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//' | cut -c1-48 | sed 's/-$//')"
    [ -n "$rest" ] || die "the message needs a summary after the type: \"$type(scope): what changes\""
    printf '%s/%s\n' "$type" "$rest"
}

ship() {
    local message="" body="" check=1 branch
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --body) body="${2:?--body needs text}"; shift 2 ;;
            --no-check) check=0; shift ;;
            -*) die "unknown option: $1" ;;
            *) [ -z "$message" ] || die "give the message once, in quotes"; message="$1"; shift ;;
        esac
    done
    need_gh
    branch="$(git branch --show-current)"
    if [ "$branch" = main ]; then
        [ -n "$message" ] || die "on main: give the commit message, ./iris ship \"fix(scope): summary\""
        clean_tree && die "nothing to ship: no changes"
        branch="$(branch_for "$message")"
        git fetch --quiet origin main
        [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || \
            die "main is behind origin/main; run ./iris sync first (your changes stay)"
        git switch --quiet -c "$branch"
        say "branch $branch"
    fi
    if ! clean_tree; then
        [ -n "$message" ] || die "there are uncommitted changes: give a commit message"
        if [ "$check" = 1 ]; then
            "$(python_bin)" -m ruff check core scripts tests server.py || die "fix the lint first (or --no-check)"
        fi
        git add -A
        git status --short
        if [ -n "$body" ]; then git commit --quiet -m "$message" -m "$body"; else git commit --quiet -m "$message"; fi
    fi
    [ -n "$(git log --oneline origin/main..HEAD)" ] || die "this branch has no commits beyond main"
    git push --quiet -u origin HEAD
    if ! gh pr view --json number >/dev/null 2>&1; then
        gh pr create --base main --fill-verbose >/dev/null
    fi
    # Merges as soon as the required checks pass; nothing else to do here.
    gh pr merge --auto --merge --delete-branch >/dev/null 2>&1 || \
        say "auto-merge is off for this repository: merge in the browser once CI is green"
    say "PR: $(gh pr view --json url --jq .url)"
    git switch --quiet main
    say "back on main; the next change can start now"
}

save() {
    local message="" body="" branch
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --body) body="${2:?--body needs text}"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) [ -z "$message" ] || die "give the message once, in quotes"; message="$1"; shift ;;
        esac
    done
    [ -n "$message" ] || die "usage: ./iris save \"fix(scope): summary\""
    branch="$(branch_for "$message")"
    clean_tree && die "nothing to save: no changes"
    if [ "$(git branch --show-current)" = main ]; then
        git switch --quiet -c "$branch"
        say "branch $branch (later: ./iris ship)"
    fi
    git add -A
    if [ -n "$body" ]; then git commit --quiet -m "$message" -m "$body"; else git commit --quiet -m "$message"; fi
    say "saved: $(git log -1 --format='%h %s')"
}

snapshot() {
    # A commit of the working copy as it is now, untracked files included and
    # ignored ones left out, without touching the branch, the index or the stash.
    local index tree
    index="$(mktemp)"
    rm -f "$index"
    GIT_INDEX_FILE="$index" git add -A
    tree="$(GIT_INDEX_FILE="$index" git write-tree)"
    rm -f "$index"
    if clean_tree; then
        git rev-parse HEAD
    else
        git -c user.name="Iris try" -c user.email="try@localhost" \
            commit-tree "$tree" -p HEAD -m "try: $(git branch --show-current) + uncommitted changes"
    fi
}

try_on_staging() {
    [ "$#" -eq 0 ] || die "try takes no arguments"
    [ -n "${IRIS_SERVER:-}" ] || die "set IRIS_SERVER (an ssh host) in .iris.local"
    local commit dir
    commit="$(snapshot)"
    dir="$(install_dir staging)"
    say "sending $(git branch --show-current) @ $(git rev-parse --short "$commit") to staging"
    # Straight to the staging checkout over ssh, under a ref of its own; the
    # pre-push hook guards what goes public and this never leaves the server.
    git push --quiet --no-verify --force "$IRIS_SERVER:$dir" "$commit:refs/staging/try"
    remote staging "./scripts/staging.sh update --ref refs/staging/try"
}

sync() {
    clean_tree || die "commit or stash your changes first"
    git switch --quiet main
    git pull --quiet --ff-only origin main
    git fetch --quiet --prune origin
    local branch
    # Only branches whose remote is gone and whose commits are all in main.
    git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | \
        awk '$2 == "[gone]" {print $1}' | while read -r branch; do
            if git branch --quiet -d "$branch" 2>/dev/null; then say "deleted merged branch $branch"; fi
        done
    say "main is at $(git log -1 --format='%h %s')"
}

release() {
    local version="${1:-}" tag current notes previous
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$ ]] || die "usage: ./iris release X.Y.Z"
    tag="v$version"
    need_gh
    clean_tree || die "commit or stash your changes first"
    git fetch --quiet --tags origin main
    git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null && die "$tag already exists"
    current="$(git show origin/main:pyproject.toml | sed -n 's/^version = "\(.*\)"/\1/p')"
    if [ "$current" = "$version" ]; then
        # Second run: main carries the version, so tag exactly that commit.
        git tag -a "$tag" -m "Iris $version" origin/main
        git push --quiet origin "$tag"
        say "tagged $tag at $(git rev-parse --short origin/main); the image is published in a few minutes"
        say "after testing it on staging, run: ./iris deploy"
        return
    fi
    # First run: a PR that bumps the version and starts the release notes.
    git switch --quiet main
    git pull --quiet --ff-only origin main
    git switch --quiet -c "chore/release-$version"
    sed -i "s/^version = \".*\"/version = \"$version\"/" pyproject.toml
    notes="docs/releases/$version.md"
    mkdir -p docs/releases
    if [ ! -f "$notes" ]; then
        previous="$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || true)"
        {
            printf '# Iris %s\n\n## Changes since %s\n\n' "$version" "${previous#v}"
            git log --no-merges --format='- %s' "${previous:+$previous..}HEAD" -- . ':!docs/releases'
            printf '\n## Deployment\n\n- `./scripts/server.sh update` (backs up first).\n'
        } > "$notes"
    fi
    "${EDITOR:-vi}" "$notes"
    git add pyproject.toml "$notes"
    git commit --quiet -m "chore(release): prepare version $version"
    git push --quiet -u origin HEAD
    gh pr create --base main --fill >/dev/null
    gh pr merge --auto --merge --delete-branch >/dev/null 2>&1 || true
    say "release PR: $(gh pr view --json url --jq .url)"
    git switch --quiet main
    say "once it merged, run ./iris release $version again to tag it"
}

case "${1:-help}" in
    dev) shift; exec "$(python_bin)" scripts/dev.py "$@" ;;
    check)
        "$(python_bin)" -m ruff check core scripts tests server.py
        exec ./scripts/run_tests.sh
        ;;
    ship) shift; ship "$@" ;;
    save) shift; save "$@" ;;
    try) shift; try_on_staging "$@" ;;
    sync) sync ;;
    release) shift; release "$@" ;;
    staging) shift; remote staging "./scripts/staging.sh update$(quote_args "$@")" ;;
    deploy) remote prod ./scripts/server.sh update ;;
    status)
        echo "== production"; remote prod ./scripts/server.sh status || true
        echo "== staging"; remote staging ./scripts/staging.sh status || true
        ;;
    logs)
        if [ "${2:-prod}" = staging ]; then
            remote staging 'docker compose logs -f iris 2>/dev/null || sudo docker compose logs -f iris'
        else
            remote prod ./scripts/server.sh logs
        fi
        ;;
    doctor) remote "${2:-prod}" ./scripts/server.sh doctor ;;
    shell) remote "${2:-prod}" 'exec $SHELL -l' ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
