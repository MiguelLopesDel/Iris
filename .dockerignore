.env
.env.*
!.env.example
.git
.gitignore
*.pem
*.key
*.crt
secrets/
data/
media/
backups/
*.db
*.faiss
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
venv/
.venv/
env/
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.mov
*.mkv
*.webm
*.tar.gz

# The Android client is not part of the server image. Without this, every app
# commit invalidates the COPY layer and forces a pointless rebuild on the server.
android/
.android-sdk/
.android-avd/
.Trash-*/

# Personal and secret files that live in a working checkout. The published
# images are built from a clean checkout in CI, but a server that builds its own
# (staging, `docker compose build`) would otherwise copy them into the image.
.release-keys/
*.jks
*.keystore
.iris.local
.iris-dev/
.iris-load/
.iris-perf/
.tools/
docker-compose.override.yml
